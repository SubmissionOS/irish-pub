---
import '../styles/global.css';
// FEINSCHLIFF-START
import '../styles/schrift.css';
import '../styles/akzente-irisch.css';
import '../styles/feinschliff.css';
// FEINSCHLIFF-ENDE
// MODERN-START
import '../styles/modern.css';
// MODERN-END
// GRUEN-START
import '../styles/gruen.css';
// GRUEN-ENDE
import ActionBar from '../components/ActionBar.astro';
import Kobold from '../components/Kobold.astro';
// MODERN-START Teil 4: Schriften vorladen
import fontDisplay from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-700-normal.woff2?url';
import fontText from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
// MODERN-ENDE
import site from '../content/site.json';
import { t, href, mainNav, legalNav, fmtTime, type Lang, type PageKey } from '../lib/i18n';

interface Props { lang: Lang; page: PageKey; jsonLd?: object; title?: string; noindex?: boolean }
const { lang, page, jsonLd } = Astro.props;
const d = t(lang);
// Entwurfs-Flag aus site.json, für Messungen per PUBLIC_DRAFT=false abschaltbar
const draft = import.meta.env.PUBLIC_DRAFT === 'false' ? false : site.draft;
const meta = { ...(d.pages[page] as { title: string; description: string }), ...(Astro.props.title ? { title: Astro.props.title } : {}) };
const other: Lang = lang === 'de' ? 'en' : 'de';
const abs = (p: string) => new URL(p, site.url).href;
const canonical = abs(href(lang, page));
const week = [1, 2, 3, 4, 5, 6, 0].map((day) => site.hours.find((h) => h.day === day)!);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'de' ? 'de' : 'en-GB'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  {draft && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={abs(href('de', page))} />
  <link rel="alternate" hreflang="en" href={abs(href('en', page))} />
  <link rel="alternate" hreflang="x-default" href={abs(href('de', page))} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
  <meta property="og:image" content={abs("/og-bar.jpg")} />
  <meta name="theme-color" content="#123a2c" />
  <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#inhalt">{d.ui.skip}</a>
  <div class="shell">
    <aside class="rail">
      <div class="rail__top">
        <a class="plaque" href={href(lang, "start")}>
          <span class="plaque__small">Irish Pub in the</span>
          <span class="plaque__name">Fleetenkieker</span>
          <span class="plaque__addr">Börsenbrücke 10</span>
        </a>
        <button class="rail__toggle" type="button" aria-expanded="false" aria-controls="hauptnav">
          <span class="rail__toggle-open">{d.ui.menu}</span>
          <span class="rail__toggle-close">{d.ui.close}</span>
        </button>
      </div>
      <div class="rail__body" id="hauptnav">
        <nav aria-label={d.ui.menu}>
          <ul class="signs">
            {mainNav.map((k) => (
              <li><a href={href(lang, k)} aria-current={k === page ? 'page' : undefined}>{d.nav[k]}</a></li>
            ))}
          </ul>
        </nav>
        <div class="rail__foot">
          <ul class="lang" aria-label={d.ui.switchLabel}>
            <li><a href={href('de', page)} hreflang="de" lang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a></li>
            <li><a href={href('en', page)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a></li>
          </ul>
          <a class="rail__phone" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </aside>

    <div class="stage">
      {draft && <p class="draft" role="note">{d.ui.banner}</p>}
      <main id="inhalt" tabindex="-1">
        <slot />
      </main>
      <footer class="foot">
        <div class="foot__kobold">
          <Kobold pose="sitzt" />
          <p><span class="foot__toast" lang="ga">{site.irish.toast}</span><br />{d.ui.rainbow}</p>
        </div>
        <address class="foot__addr">
          {site.name}<br />{site.street}, {site.zip} {site.city}<br />
          <a href={site.phoneHref}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
        <ul class="foot__links">
          <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
          <li><a href={site.social.instagram} rel="noopener">Instagram</a></li>
          {legalNav.map((k) => <li><a href={href(lang, k)} aria-current={k === page ? "page" : undefined}>{d.nav[k]}</a></li>)}
        </ul>
        <p class="foot__copy muted">© {year} {site.company.name}. {d.ui.draftCredit}</p>
      </footer>
      <ActionBar lang={lang} />
    </div>
  </div>
  <script>
    const btn = document.querySelector<HTMLButtonElement>('.rail__toggle');
    const rail = document.querySelector<HTMLElement>('.rail');
    const setOpen = (open: boolean) => {
      btn?.setAttribute('aria-expanded', String(open));
      rail?.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) rail?.querySelector<HTMLAnchorElement>('.signs a')?.focus();
    };
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && rail?.classList.contains('is-open')) {
        setOpen(false);
        btn?.focus();
      }
    });
  </script>
</body>
</html>
