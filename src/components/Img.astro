---
// Bild von der Altseite (Hotlink im Entwurf). Fällt es aus, erscheint eine ruhige Platzhalterfläche.
import site from '../content/site.json';
interface Props { file: string; alt: string; fallback: string; class?: string; eager?: boolean; width?: number; height?: number }
const { file, alt, fallback, class: cls, eager = false, width, height } = Astro.props;
const src = file.startsWith('http') ? file : site.imgBase + file;
const onerror =
  "var s=document.createElement('span');s.className='img-fallback '+(this.dataset.cls||'');s.setAttribute('role','img');s.setAttribute('aria-label',this.alt);s.textContent=this.dataset.fallback;this.replaceWith(s)";
---
<img
  src={src}
  alt={alt}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  width={width}
  height={height}
  data-fallback={fallback}
  data-cls={cls ?? ''}
  onerror={onerror}
/>
