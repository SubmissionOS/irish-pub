---
// Eigener Kobold (Leprechaun), Eigenentwurf von GuddiWeb. Flacher Cartoon-Stil, dicke Konturen.
// Posen: "luegt" (schaut über den Rand der Kurstafel), "sitzt" (auf dem Goldtopf), "winkt" (404).
interface Props { pose: 'luegt' | 'sitzt' | 'winkt'; class?: string }
const { pose, class: cls } = Astro.props;
const vb = { luegt: '14 6 92 104', sitzt: '14 6 92 154', winkt: '10 6 104 150' }[pose];
---
<svg class={`kobold kobold--${pose} ${cls ?? ''}`} viewBox={vb} aria-hidden="true" focusable="false">
  <g stroke="#0a1a13" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
    {pose === 'sitzt' && (
      <g>
        <path d="M38 98h44l5 30H33z" fill="#2f8f5b" />
        <path d="M50 98h20l-2 30H52z" fill="#0c241b" />
        <circle cx="60" cy="108" r="1.6" fill="#d4a94a" stroke="none" />
        <circle cx="60" cy="117" r="1.6" fill="#d4a94a" stroke="none" />
        <path d="M27 124h66a4 4 0 0 1 0 8H27a4 4 0 0 1 0-8z" fill="#2b2f2d" />
        <path d="M30 132h60l-6 24H36z" fill="#1d2120" />
        <ellipse cx="45" cy="120" rx="7" ry="4" fill="#d4a94a" />
        <ellipse cx="76" cy="120" rx="7" ry="4" fill="#d4a94a" />
        <ellipse class="kobold__shine" cx="61" cy="118" rx="7" ry="4" fill="#e6c578" />
        <path d="M44 132v10M76 132v10" />
        <ellipse cx="42" cy="146" rx="9" ry="5.5" fill="#0c241b" />
        <ellipse cx="78" cy="146" rx="9" ry="5.5" fill="#0c241b" />
        <circle cx="34" cy="114" r="6" fill="#f3c9a1" />
        <circle cx="86" cy="114" r="6" fill="#f3c9a1" />
      </g>
    )}
    {pose === 'winkt' && (
      <g>
        <path d="M84 102l14-24" fill="none" stroke-width="9" stroke="#0a1a13" />
        <path d="M84 102l14-24" fill="none" stroke-width="5" stroke="#2f8f5b" />
        <circle cx="100" cy="72" r="7" fill="#f3c9a1" />
        <path d="M38 98h44l4 34H34z" fill="#2f8f5b" />
        <path d="M50 98h20l-2 34H52z" fill="#0c241b" />
        <circle cx="60" cy="109" r="1.6" fill="#d4a94a" stroke="none" />
        <circle cx="60" cy="119" r="1.6" fill="#d4a94a" stroke="none" />
        <path d="M46 132v10M74 132v10" />
        <ellipse cx="44" cy="146" rx="9" ry="5.5" fill="#0c241b" />
        <ellipse cx="76" cy="146" rx="9" ry="5.5" fill="#0c241b" />
        <circle cx="32" cy="118" r="6" fill="#f3c9a1" />
        <circle class="kobold__shine" cx="26" cy="126" r="6" fill="#d4a94a" />
      </g>
    )}
    <path d="M38 48l4-34h36l4 34z" fill="#2f8f5b" />
    <path d="M40 37h40v10H40z" fill="#0c241b" />
    <rect x="53" y="35.5" width="14" height="13" rx="1.5" fill="none" stroke="#d4a94a" stroke-width="3" />
    <path d="M26 47h68a4.5 4.5 0 0 1 0 9H26a4.5 4.5 0 0 1 0-9z" fill="#2f8f5b" />
    <path d="M33 56q-5 9 1 17l7-3V56zM87 56q5 9-1 17l-7-3V56z" fill="#d9622b" />
    <circle cx="37" cy="68" r="5" fill="#f3c9a1" />
    <circle cx="83" cy="68" r="5" fill="#f3c9a1" />
    <ellipse cx="60" cy="68" rx="22" ry="17" fill="#f3c9a1" />
    <path d="M37 72q2 28 23 31q21-3 23-31q-6 9-13 7q-10 6-20 0q-7 2-13-7z" fill="#d9622b" />
    <path d="M52 84q8 7 16 0" fill="#7a2a14" stroke-width="2.5" />
    <path d="M47 77q6-5 13 0q7-5 13 0q-6 5-13 2q-7 3-13-2z" fill="#b84d1e" stroke-width="2.5" />
    <ellipse cx="60" cy="72" rx="5" ry="4" fill="#eaa67f" stroke-width="2.5" />
    <path d="M46 57l8 1M74 57l-8 1" stroke="#b84d1e" />
    {pose === 'luegt' ? (
      <g stroke="none" fill="#0a1a13">
        <ellipse cx="52" cy="65" rx="2.8" ry="3.4" />
        <ellipse cx="68" cy="65" rx="2.8" ry="3.4" />
      </g>
    ) : (
      <g stroke="none" fill="#0a1a13">
        <ellipse cx="52" cy="63" rx="2.8" ry="3.6" />
        <ellipse cx="68" cy="63" rx="2.8" ry="3.6" />
      </g>
    )}
    <g stroke="none" fill="#e8907a" opacity=".7">
      <circle cx="45" cy="71" r="3" />
      <circle cx="75" cy="71" r="3" />
    </g>
    {pose === 'luegt' && (
      <g>
        <ellipse cx="34" cy="101" rx="10" ry="7" fill="#f3c9a1" />
        <ellipse cx="86" cy="101" rx="10" ry="7" fill="#f3c9a1" />
        <path d="M30 98v5M35 97v6M82 98v5M87 97v6" stroke-width="2" />
      </g>
    )}
  </g>
</svg>
