---
// Gibt Text aus und hebt [Platzhalter] automatisch als sichtbare Markierung hervor.
interface Props { text: string; as?: string; class?: string }
const { text, as: Tag = 'span', class: cls } = Astro.props;
const parts = text.split(/(\[[^\]]+\])/g).filter(Boolean);
---
<Tag class={cls}>{parts.map((p) => (p.startsWith('[') && p.endsWith(']') ? <mark class="ph">{p}</mark> : p))}</Tag>
