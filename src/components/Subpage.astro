---
// Rahmen jeder Unterseite: eigener Kopf je Seite (kein Eyebrow, kein Lead mit Buttonpaar),
// Inhalt mit Seitenspalte (nur Desktop), zwei Verweise.
import site from '../content/site.json';
import TapRow from './TapRow.astro';
import Photo from './Photo.astro';
import { t, href, fmtTime, related, type Lang, type PageKey } from '../lib/i18n';
interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const d = t(lang);
const p = d.pages[page] as { h1: string; tag?: string; action?: string };
const legal = page === 'impressum' || page === 'datenschutz';
const noAside = legal || page === 'galerie';
const rel = related[page];
const week = [1, 2, 3, 4, 5, 6, 0].map((day) => site.hours.find((h) => h.day === day)!);
const bandIds = ['67137274', '67137281', '67137278', '67137275'];
const band = bandIds.map((id) => site.gallery.find((g) => g.id === id)!);
---
<header class={`head head--${page}`}>
  {page === 'live-sport' && (
    <>
      <ol class="head__screens" aria-hidden="true">
        {[1, 2, 3, 4, 5, 6].map((n) => <li><span>TV {n}</span></li>)}
      </ol>
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
    </>
  )}
  {page === 'live-musik' && (
    <div class="head__stage">
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
    </div>
  )}
  {page === 'getraenke' && (
    <>
      <TapRow />
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
    </>
  )}
  {page === 'speisen' && (
    <div class="head__chalk">
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
    </div>
  )}
  {page === 'pub-quiz' && (
    <div class="head__note">
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
      <a class="head__action" href={site.phoneHref}>{p.action}</a>
    </div>
  )}
  {page === 'ueber-uns' && (
    <>
      <h1 class="head__big">{p.h1}</h1>
      <p class="head__tag head__tag--ga" lang="ga">{p.tag}</p>
    </>
  )}
  {page === 'galerie' && (
    <>
      <div class="head__band" aria-hidden="true">
        {band.map((g) => <Photo file={`${g.id}.${g.ext}`} alt="" sizes="(min-width: 64rem) 20vw, 40vw" />)}
      </div>
      <h1>{p.h1}</h1>
    </>
  )}
  {page === 'kontakt-anfahrt' && (
    <div class="head__sign">
      <h1>{p.h1}</h1>
      <address>{site.street}<br />{site.zip} {site.city}</address>
      <a class="head__action" href={site.routeLink} rel="noopener">{d.ui.route}</a>
    </div>
  )}
  {page === 'auszeichnungen-presse' && (
    <>
      <h1>{p.h1}</h1>
      <p class="head__tag">{p.tag}</p>
    </>
  )}
  {legal && <h1>{p.h1}</h1>}
</header>

{noAside ? (
  <div class="sub-main"><slot /></div>
) : (
  <div class="sub-grid">
    <div class="sub-main"><slot /></div>
    <aside class="sub-aside" aria-label={d.ui.asideTitle}>
      <h2>{d.ui.hoursTitle}</h2>
      <table>
        <tbody>
          {week.map((h) => <tr><th scope="row">{d.days[h.day]}</th><td>{fmtTime(h.open)}–{fmtTime(h.close)}</td></tr>)}
        </tbody>
      </table>
      <p><a class="sub-aside__phone" href={site.phoneHref}>{site.phone}</a></p>
    </aside>
  </div>
)}

{rel && (
  <nav class="related" aria-label={d.ui.related}>
    <ul>
      {rel.map((k) => (
        <li><a href={href(lang, k)}>{d.nav[k]}</a></li>
      ))}
    </ul>
  </nav>
)}
