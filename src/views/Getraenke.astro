---
import Photo from '../components/Photo.astro';
import TapRow from '../components/TapRow.astro';
import site from '../content/site.json';
import vorschlag from '../content/vorschlag.json';
import { t, eur, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).pages.getraenke;
---

<div class="split">
  <section class="chalk" aria-labelledby="tap-title">
    <h2 id="tap-title">{p.tapTitle}</h2>
    <p class="chalk__note">{p.tapNote}</p>
    <TapRow />
    <table>
      <thead><tr><th scope="col">{p.tapHead.name}</th><th scope="col">{p.tapHead.p03}</th><th scope="col">{p.tapHead.p05}</th></tr></thead>
      <tbody>
        {vorschlag.fass.map((b) => (
          <tr><th scope="row">{b.name[lang]}</th><td>{eur(b.p03, lang)}</td><td>{eur(b.p05, lang)}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
  <figure class="photo">
    <Photo file={site.barPhoto} alt={p.barAlt} sizes="(min-width: 40rem) 640px, 100vw" />
    <figcaption>{p.barCaption}</figcaption>
  </figure>
</div>

<section class="section chalk" aria-labelledby="board-title">
  <h2 id="board-title">{p.boardTitle}</h2>
  <div class="groups">
    {vorschlag.karte.map((g) => (
      <div>
        <h3>{g.title[lang]}</h3>
        {g.note && <p class="chalk__note">{g.note[lang]}</p>}
        <ul class="chalk__list">
          {g.items.map((it) => (
            <li><span class="chalk__name">{it.name[lang]}</span><span class="chalk__price">{eur(it.price, lang)}</span></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="chalk__note">{p.priceNote}</p>
</section>
