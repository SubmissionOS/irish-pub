---
import vorschlag from '../content/vorschlag.json';
import { t, eur, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).pages.speisen;
---
<div class="menu">
  {vorschlag.speisen.map((g, i) => (
    <details class="acc" open={i === 0}>
      <summary><h2>{g.title[lang]}</h2></summary>
      <ul class="chalk__list">
        {g.items.map((it) => (
          <li>
            <span class="chalk__name">{it.name[lang]}</span>
            <span class="chalk__price">{eur(it.price, lang)}</span>
            <span class="chalk__desc">{it.desc[lang]}</span>
          </li>
        ))}
      </ul>
    </details>
  ))}
  <p class="acc__note">{p.allergens}</p>
</div>
