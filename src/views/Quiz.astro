---
import Photo from '../components/Photo.astro';
import site from '../content/site.json';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages['pub-quiz'];
---

<div class="split">
  <section aria-labelledby="how-title">
    <h2 id="how-title">{p.howTitle}</h2>
    <ol class="steps">{p.steps.map((s) => <li>{s}</li>)}</ol>
    <div class="actions">
      <a class="btn" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--line" href={`mailto:${site.email}?subject=Pub%20Quiz`}>{site.email}</a>
    </div>
  </section>
  <section aria-labelledby="next-title">
    <h2 id="next-title">{p.nextTitle}</h2>
    <p class="next">{p.next}</p>
    <p><a class="btn btn--line" href={site.social.facebook} rel="noopener">Facebook</a></p>
  </section>
</div>

<section class="section" aria-labelledby="photos-title">
  <h2 id="photos-title">{p.photosTitle}</h2>
  <div class="masonry">
    {site.quizPhotos.map((f) => (
      <figure><Photo file={f} alt={p.photoAlt} sizes="(min-width: 100rem) 30vw, (min-width: 40rem) 45vw, 100vw" /></figure>
    ))}
  </div>
</section>
