---
import Photo from '../components/Photo.astro';
import site from '../content/site.json';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages['pub-quiz'];
---
<section aria-labelledby="how-title">
  <h2 id="how-title">{p.howTitle}</h2>
  <ol class="steps">{p.steps.map((s) => <li>{s}</li>)}</ol>
  <p class="textlinks">
    <a href={site.phoneHref}>{site.phone}</a>
    <a href={`mailto:${site.email}?subject=Pub%20Quiz`}>{site.email}</a>
  </p>
</section>

<section class="g-section" aria-labelledby="next-title">
  <h2 id="next-title">{p.nextTitle}</h2>
  <p>{p.next} <a href={site.social.facebook} rel="noopener">Facebook</a></p>
</section>

<section class="g-section" aria-labelledby="photos-title">
  <h2 id="photos-title">{p.photosTitle}</h2>
  <ul class="swipe swipe--photos">
    {site.quizPhotos.map((f) => (
      <li><Photo file={f} alt={p.photoAlt} sizes="(min-width: 64rem) 320px, 75vw" /></li>
    ))}
  </ul>
</section>
