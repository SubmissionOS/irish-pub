---
import Board from '../components/Board.astro';
import Kobold from '../components/Kobold.astro';
import Photo from '../components/Photo.astro';
import Coins from '../components/Coins.astro';
import site from '../content/site.json';
import { t, href, fmtTime, type Lang, type PageKey } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages.start;
// Öffnungszeiten kompakt: gleiche Zeiten zusammenfassen
const short = d.days.map((n) => n.slice(0, 2));
const groups = [
  { days: [1, 4], h: site.hours.find((h) => h.day === 1)! },
  { days: [5, 5], h: site.hours.find((h) => h.day === 5)! },
  { days: [6, 6], h: site.hours.find((h) => h.day === 6)! },
  { days: [0, 0], h: site.hours.find((h) => h.day === 0)! },
];
const icons: Record<string, string> = {
  tv: '<rect x="4" y="7" width="32" height="21" rx="2"/><path d="M14 33h12M20 28v5"/>',
  note: '<path d="M15 29V9l17-4v20"/><circle cx="11" cy="29" r="4"/><circle cx="28" cy="25" r="4"/>',
  tap: '<path d="M16 5h8v9h-8zM20 14v4M12 18h16v6H12zM22 24h4v7h-4z"/><path d="M10 35h20"/>',
  quiz: '<circle cx="20" cy="20" r="15"/><path d="M15 15a5 5 0 1 1 6 5c-1 .5-1 1.5-1 3M20 28v.5"/>',
};
---
<section class="hero hero--sign">
  <h1 class="wordmark">
    <span class="wordmark__a">Irish Pub</span>
    <span class="wordmark__b">in the</span>
    <span class="wordmark__c">Fleetenkieker</span>
  </h1>
  <Board lang={lang}><Kobold pose="luegt" slot="kobold" /></Board>
</section>

<nav class="g-section entries" aria-label={p.entriesTitle}>
  <ul class="swipe">
    {p.entries.map((e) => (
      <li>
        <a class="entry" href={href(lang, e.key as PageKey)}>
          <svg viewBox="0 0 40 40" aria-hidden="true" set:html={icons[e.icon]} />
          <span>{e.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<section class="g-section welcome-photo" aria-labelledby="welcome-title">
  <Photo file="67137274.jpg" alt={p.photoAlt} sizes="(min-width: 64rem) 60vw, 100vw" />
  <h2 id="welcome-title">
    <span class="welcome__title" lang="ga">{p.welcomeTitle}</span>
    <span class="welcome__sub">{p.welcomeSub}</span>
  </h2>
</section>

<section class="g-section" aria-labelledby="awards-title">
  <h2 id="awards-title">{p.awardsTitle}</h2>
  <div class="swipe swipe--coins"><Coins label={p.awardsTitle} /></div>
  <a class="more" href={href(lang, 'auszeichnungen-presse')}>{p.awardsLink}</a>
</section>

<section class="g-section contact-block" aria-labelledby="contact-title">
  <h2 id="contact-title">{p.contactTitle}</h2>
  <address>{site.street}, {site.zip} {site.city}</address>
  <ul class="hours-mini">
    {groups.map((g) => (
      <li>
        <span>{g.days[0] === g.days[1] ? d.days[g.days[0]] : `${short[g.days[0]]}–${short[g.days[1]]}`}</span>
        <span>{fmtTime(g.h.open)}–{fmtTime(g.h.close)}</span>
      </li>
    ))}
  </ul>
  <p class="contact-block__links">
    <a href={site.routeLink} rel="noopener">{d.ui.route}</a>
    <a href={site.phoneHref}>{site.phone}</a>
  </p>
</section>
