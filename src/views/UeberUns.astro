---
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).pages['ueber-uns'];
---
{p.text.map((para) => <p>{para}</p>)}
<p class="signature">{p.signature}</p>

<div class="section welcome">
  <h2>{p.houseTitle}</h2>
  <p>{p.house}</p>
  <h2>{p.nameTitle}</h2>
  <p>{p.name}</p>
  <h2>{p.teamTitle}</h2>
  <p>{p.team}</p>
</div>
