---
import site from '../content/site.json';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).pages.impressum;
const c = site.company;
---
<div class="legal">
  <h2>{p.providerTitle}</h2>
  <address>{c.name}<br />{site.street}<br />{site.zip} {site.city}</address>
  <p>{p.ceoLabel}: {c.ceo}</p>
  <h2>{p.contactTitle}</h2>
  <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
  <h2>{p.registerTitle}</h2>
  <p>{c.hrb}</p>
  <h2>{p.authorityTitle}</h2>
  <p>{c.authority}</p>
  <h2>{p.respTitle}</h2>
  <p>{p.resp}</p>
</div>
