---
import site from '../content/site.json';
import Coins from '../components/Coins.astro';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pages['auszeichnungen-presse'];
---

<section aria-labelledby="aw-title">
  <h2 id="aw-title">{p.awardsTitle}</h2>
  <Coins label={p.awardsTitle} />
  <p><a href={site.awardsSource} rel="noopener">{p.source}</a></p>
</section>

<section class="g-section" aria-labelledby="press-title">
  <h2 id="press-title">{p.pressTitle}</h2>
  <ul class="press swipe">
    {site.press.map((a) => (
      <li>
        <div>
          <p class="press__outlet">{a.outlet}</p>
          <h3 lang={a.lang}>{a.title}</h3>
          <a href={a.url} rel="noopener">{p.readOn} {a.outlet}</a>
        </div>
      </li>
    ))}
  </ul>
</section>
