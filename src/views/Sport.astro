---
import site from '../content/site.json';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).pages['live-sport'];
const mailHref = `mailto:${site.email}?subject=${encodeURIComponent(p.wishTitle)}`;
---
<section aria-labelledby="screens-title">
  <h2 id="screens-title">{p.screensTitle}</h2>
  <ul class="chips">{p.sports.map((s) => <li>{s}</li>)}</ul>
</section>

<section class="g-section" aria-labelledby="prog-title">
  <h2 id="prog-title">{p.programTitle}</h2>
  <p>{p.program}</p>
  <p class="textlinks">
    <a href={site.social.facebook} rel="noopener">Facebook</a>
    <a href={site.social.instagram} rel="noopener">Instagram</a>
  </p>
</section>

<section class="g-section" aria-labelledby="wish-title">
  <h2 id="wish-title">{p.wishTitle}</h2>
  <p>{p.wishText} <a href={mailHref}>{site.email}</a></p>
</section>
